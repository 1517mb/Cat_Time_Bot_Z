# Copy this file to .env and replace the example values.
# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# OpenWeather API key for the weather briefing.
OPENWEATHER_API_KEY=your_openweather_api_key

# Numeric chat ID for default scheduled messages (example group ID).
CHAT_ID=-1001234567890
